{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "archive/**",
      "README.md",
      "**/.*",
      "**/node_modules/**",
      "**/*.ps1",
      "**/*.txt",
      "**/*.exe",
      ".idea/**",
      "tests/**",
      "e2e/**",
      "package.json",
      "package-lock.json"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  }
}